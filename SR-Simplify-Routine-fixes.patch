+++ b/tests/http/smoke.py
@@ -0,0 +1,89 @@
+"""Run after a Release build: python tests/http/smoke.py. Uses only Python's standard library.
+Creates a disposable database and keys; no external email is sent.
+"""
+import html, http.cookiejar, json, os, re, secrets, subprocess, tempfile, time
+from pathlib import Path
+from urllib import request, parse, error
+
+root = Path(__file__).resolve().parents[2]
+app = root / 'src/SrSimplifyRoutine.Web'
+dotnet = os.environ.get('SR_DOTNET', 'dotnet')
+base = 'http://127.0.0.1:5147'
+messages = []
+with tempfile.TemporaryDirectory(prefix='sr-http-') as temp:
+    env = dict(os.environ, ASPNETCORE_ENVIRONMENT='Development', ASPNETCORE_URLS=base,
+               ConnectionStrings__DefaultConnection=f'Data Source={temp}/test.db;Foreign Keys=True',
+               Application__KeysPath=f'{temp}/keys', Smtp__Host='', BotProtection__Enabled='false')
+    command = [dotnet, 'bin/Release/net10.0/SrSimplifyRoutine.Web.dll']
+    demo = subprocess.run(command + ['--create-demo'], cwd=app, env=env, capture_output=True, text=True, check=True)
+    demo_email = re.search(r'^Email: (.+)$', demo.stdout, re.M)[1]
+    demo_password = re.search(r'^Password: (.+)$', demo.stdout, re.M)[1]
+    cookies = http.cookiejar.CookieJar()
+    client = request.build_opener(request.ProxyHandler({}), request.HTTPCookieProcessor(cookies))
+    def fetch(path, data=None, headers=None):
+        req = request.Request(base + path, data=parse.urlencode(data).encode() if data is not None else None, headers=headers or {})
+        try:
+            response = client.open(req, timeout=15)
+        except error.HTTPError as ex:
+            response = ex
+        return response.status, response.read().decode(), response.geturl(), response.headers
+    def post(path, values):
+        status, body, _, _ = fetch(path)
+        assert status == 200, (path, status)
+        hidden = {html.unescape(k): html.unescape(v) for k, v in re.findall(r'<input[^>]*type="hidden"[^>]*name="([^"]+)"[^>]*value="([^"]*)"', body)}
+        assert '__RequestVerificationToken' in hidden and '_handler' in hidden, 'Missing form metadata'
+        return fetch(path, dict(hidden, **values))
+    with open(Path(temp) / 'server.log', 'w+') as log:
+        server = subprocess.Popen(command, cwd=app, env=env, stdout=log, stderr=log)
+        try:
+            for _ in range(80):
+                try:
+                    if fetch('/')[0] == 200: break
+                except (OSError, error.URLError): pass
+                if server.poll() is not None:
+                    log.seek(0); raise AssertionError(log.read())
+                time.sleep(.25)
+            else: raise AssertionError('Server did not start')
+            assert '/Account/Login' in fetch('/dashboard')[2]
+            assert fetch('/missing-page')[0] == 404
+            assert fetch('/Account/Login', {'Input.Email': 'x'})[0] == 400
+            assert fetch('/dev/inbox?id=../../appsettings.json')[0] == 404
+            assert fetch('/dev/inbox', headers={'Host': 'attacker.example'})[0] in (400,404)
+            print('PASS anonymous access, antiforgery, missing page and inbox path/host restrictions')
+            email = f'http-{secrets.token_hex(8)}@example.test'
+            password = secrets.token_urlsafe(24)
+            status, body, url, _ = post('/Account/Register', {'Input.DisplayName': 'HTTP test', 'Input.Email': email,
+                'Input.Password': password, 'Input.ConfirmPassword': password, 'Input.Website': ''})
+            assert status == 200 and 'RegisterConfirmation' in url, (status, url)
+            assert 'Open local inbox' in body
+            status, body, url, _ = post('/Account/Login', {'Input.Email': email, 'Input.Password': password})
+            assert '/Account/Login' in url and 'Invalid login' in body
+            inbox = fetch('/dev/inbox')
+            assert inbox[0] == 200 and inbox[3]['Cache-Control'] == 'no-store'
+            file = next(f for f in (app/'.dev-mail').glob('*.html') if email in f.read_text())
+            messages.append(file)
+            status, body, _, _ = fetch('/dev/inbox?id=' + file.name)
+            assert status == 200
+            link = html.unescape(re.search(r'href="([^"]+)"', body)[1])
+            assert fetch(link.removeprefix(base))[0] == 200
+            status, body, url, _ = post('/Account/Login', {'Input.Email': email, 'Input.Password': password})
+            assert status == 200 and url.endswith('/dashboard'), (status, url)
+            for page in ('dashboard','calendar','planner','studies','workouts','categories','progress','preferences'):
+                status, body, url, _ = fetch('/' + page)
+                assert status == 200 and '/Account/Login' not in url, (page, status, url)
+            print('PASS registration, local inbox, blocked unconfirmed login, confirmation and all planner pages')
+            cookies.clear()
+            status, body, url, _ = post('/Account/Login', {'Input.Email': demo_email, 'Input.Password': demo_password})
+            assert status == 200 and url.endswith('/dashboard'), (status,url)
+            print('PASS generated test credentials sign in successfully')
+            prod = subprocess.run(command + ['--create-demo'], cwd=app,
+                env=dict(env, ASPNETCORE_ENVIRONMENT='Production'), capture_output=True, text=True)
+            assert prod.returncode != 0 and 'only in Development' in prod.stderr
+            smtp = subprocess.run(command + ['--test-email', 'nobody@example.test'], cwd=app,
+                env=env, capture_output=True, text=True)
+            assert smtp.returncode != 0 and 'Configure Smtp:Host' in smtp.stderr
+            print('PASS production refuses demo creation; SMTP test refuses missing configuration')
+        finally:
+            server.terminate()
+            server.wait(timeout=15)
+            for file in messages: file.unlink(missing_ok=True)
