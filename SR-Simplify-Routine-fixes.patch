diff --git a/src/SrSimplifyRoutine.Web/Services/DevelopmentTools.cs b/src/SrSimplifyRoutine.Web/Services/DevelopmentTools.cs
new file mode 100644
index 0000000..0faf1e5
--- /dev/null
+++ b/src/SrSimplifyRoutine.Web/Services/DevelopmentTools.cs
@@ -0,0 +1,68 @@
+using System.Net;
+using System.Security.Cryptography;
+using System.Text.Encodings.Web;
+using System.Text.RegularExpressions;
+using Microsoft.AspNetCore.Identity;
+using SrSimplifyRoutine.Web.Data;
+
+namespace SrSimplifyRoutine.Web.Services;
+
+public static class DevelopmentTools
+{
+    // Both checks matter: Host validation also prevents DNS rebinding.
+    public static bool IsLocalRequest(HttpContext context, IHostEnvironment environment) =>
+        environment.IsDevelopment() && context.Connection.RemoteIpAddress is { } address &&
+        IPAddress.IsLoopback(address) &&
+        (context.Request.Host.Host.Equals("localhost", StringComparison.OrdinalIgnoreCase) ||
+         context.Request.Host.Host is "127.0.0.1" or "[::1]" or "::1");
+
+    public static void MapDevelopmentInbox(this WebApplication app)
+    {
+        if (!app.Environment.IsDevelopment()) return;
+        app.MapGet("/dev/inbox", async (HttpContext context, string? id) =>
+        {
+            if (!IsLocalRequest(context, app.Environment)) return Results.NotFound();
+            context.Response.Headers.CacheControl = "no-store";
+            context.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
+            context.Response.Headers["Content-Security-Policy"] = "default-src 'none'; base-uri 'none'; frame-ancestors 'none'";
+            var directory = Path.Combine(app.Environment.ContentRootPath, ".dev-mail");
+            if (id is not null)
+            {
+                if (!Regex.IsMatch(id, @"\A[0-9]{17}-[a-f0-9]{32}\.html\z")) return Results.NotFound();
+                var path = Path.Combine(directory, id);
+                if (!File.Exists(path)) return Results.NotFound();
+                return Results.Content(await File.ReadAllTextAsync(path), "text/html");
+            }
+            var files = Directory.Exists(directory)
+                ? Directory.EnumerateFiles(directory, "*.html").OrderDescending().Take(50).ToArray() : [];
+            var items = new List<string>();
+            foreach (var file in files)
+            {
+                var name = Path.GetFileName(file);
+                // Only the sender's generated files are exposed.
+                if (!Regex.IsMatch(name, @"\A[0-9]{17}-[a-f0-9]{32}\.html\z")) continue;
+                var body = await File.ReadAllTextAsync(file);
+                var recipient = Regex.Match(body, @"<p>To: (.*?)</p>").Groups[1].Value;
+                items.Add($"<li><a href=\"/dev/inbox?id={name}\">{HtmlEncoder.Default.Encode(name)}</a> — {recipient}</li>");
+            }
+            return Results.Content("<!doctype html><meta charset=\"utf-8\"><title>SR local inbox</title><h1>Local development inbox</h1><p>These messages stay on this computer. Open a message to confirm an account or reset its password.</p><ul>" +
+                string.Join("", items) + "</ul><p><a href=\"/Account/Login\">Return to sign in</a></p>", "text/html");
+        });
+    }
+
+    public static async Task CreateDemoAccountAsync(IServiceProvider services)
+    {
+        using var scope = services.CreateScope();
+        var environment = scope.ServiceProvider.GetRequiredService<IHostEnvironment>();
+        if (!environment.IsDevelopment()) throw new InvalidOperationException("Demo accounts are available only in Development.");
+        var users = scope.ServiceProvider.GetRequiredService<UserManager<ApplicationUser>>();
+        var email = $"demo-{Guid.NewGuid():N}@example.test";
+        var password = Convert.ToBase64String(RandomNumberGenerator.GetBytes(24));
+        var result = await users.CreateAsync(new ApplicationUser
+        {
+            UserName = email, Email = email, EmailConfirmed = true, DisplayName = "Demo planner"
+        }, password);
+        if (!result.Succeeded) throw new InvalidOperationException(string.Join("; ", result.Errors.Select(e => e.Description)));
+        Console.WriteLine($"Development test account created. Save these credentials locally.\nEmail: {email}\nPassword: {password}");
+    }
+}
