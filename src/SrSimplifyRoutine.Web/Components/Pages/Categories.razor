@page "/categories"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PlannerService Planner
<PageTitle>Categories · SR Simplify Routine</PageTitle>
<div class="page-heading"><div><p class="eyebrow">A ROUTINE THAT FEELS LIKE YOU</p><h1>Your categories<span class="accent">.</span></h1><p>Create space for studies, training, hobbies and whatever comes next.</p></div></div>
@if(error is not null){<div class="notice error" role="alert">@error</div>}@if(message is not null){<div class="notice success" role="status">@message</div>}
<div class="category-page-grid"><section><div class="section-heading"><h2>Organise your world</h2><label class="checkbox-label"><input type="checkbox" @bind="showArchived" /> Show archived</label></div><div class="category-grid">@foreach(var c in categories.Where(x=>showArchived||!x.IsArchived)){<article class="card category-card" style="--category-colour:@c.Colour"><div class="category-card-top"><span class="category-icon"><Icon Name="@(c.Kind==CategoryKind.Study?"book":c.Kind==CategoryKind.Workout?"workout":"layers")" /></span><span class="type-label">@(c.IsArchived?"Archived":c.Kind.ToString())</span></div><h2>@c.Name</h2><p>@(c.WeeklyTargetMinutes>0?$"{c.WeeklyTargetMinutes} minutes / week":"No weekly target set")</p><a href="@($"planner?category={c.Id}")">View activities ↗</a><div class="category-actions"><button class="plain-button" @onclick="()=>Edit(c)">Edit</button><button class="plain-button" disabled="@busy" @onclick="()=>Archive(c)">@(c.IsArchived?"Restore":"Archive")</button></div></article>}</div><p class="field-help">Archiving hides a category from new activities. Your existing activities and progress stay intact. Up to @PlannerService.MaximumCategories categories per account.</p></section>
<section class="card category-form"><span class="eyebrow">MAKE IT YOURS</span><h2>@(input.Id.HasValue?"Edit category":"A new category")</h2><EditForm Model="input" OnValidSubmit="Save" FormName="category-editor" @key="input"><DataAnnotationsValidator /><ValidationSummary /><label for="category-name">Name</label><InputText id="category-name" class="form-control" @bind-Value="input.Name" maxlength="40" placeholder="e.g. German Learning" /><label for="category-colour">Colour</label><input id="category-colour" class="colour-picker" type="color" @bind="input.Colour" /><label for="category-kind">Section</label><InputSelect id="category-kind" class="form-select" @bind-Value="input.Kind"><option value="@CategoryKind.General">General</option><option value="@CategoryKind.Study">Studies</option><option value="@CategoryKind.Workout">Workouts</option></InputSelect><p class="field-help">Choose where these activities appear.</p><label for="category-goal">Weekly goal (minutes)</label><InputNumber id="category-goal" class="form-control" @bind-Value="input.WeeklyTargetMinutes" min="0" max="10080" /><p class="field-help">For example, 180 for three one-hour sessions. Use 0 for no target.</p><div class="form-actions"><button class="btn btn-primary" disabled="@busy">@(input.Id.HasValue?"Save changes":"Create category")</button>@if(input.Id.HasValue){<button type="button" class="btn btn-light" @onclick="Reset">Cancel</button>}</div></EditForm></section></div>
@code {
    private List<Category> categories=[];private CategoryInput input=new();private bool showArchived,busy;private string? error,message;
    protected override async Task OnInitializedAsync()=>categories=await Planner.GetCategoriesAsync(true);
    private void Edit(Category c){input=new(){Id=c.Id,Name=c.Name,Colour=c.Colour,Kind=c.Kind,WeeklyTargetMinutes=c.WeeklyTargetMinutes};error=message=null;}
    private void Reset()=>input=new();
    private async Task Save(){busy=true;error=message=null;try{await Planner.SaveCategoryAsync(input);message="Category saved. Make it part of your next activity.";Reset();categories=await Planner.GetCategoriesAsync(true);}catch(PlannerException ex){error=ex.Message;}finally{busy=false;}}
    private async Task Archive(Category c){busy=true;error=message=null;try{await Planner.ArchiveCategoryAsync(c.Id,!c.IsArchived);categories=await Planner.GetCategoriesAsync(true);}catch(PlannerException ex){error=ex.Message;}finally{busy=false;}}
}
