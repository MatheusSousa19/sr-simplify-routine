@page "/activities/new"
@page "/activities/{Id:int}/edit"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PlannerService Planner
@inject NavigationManager Navigation
<PageTitle>@(Id.HasValue ? "Edit activity" : "New activity") · SR Simplify Routine</PageTitle>
<div class="page-heading"><div><p class="eyebrow">MAKE TIME FOR WHAT MATTERS</p><h1>@(Id.HasValue ? "Edit your activity" : "A little intention")<span class="accent">.</span></h1><p>@(Id.HasValue ? "Adjust this occurrence without changing the rest of your routine." : "Give something important a place in your day.")</p></div><a class="btn btn-light" href="calendar">← Back to calendar</a></div>
@if(error is not null){<div class="notice error" role="alert">@error</div>}
@if(ready && profile is not null)
{
<div class="editor-grid"><section class="card editor-card"><EditForm Model="input" OnValidSubmit="Save" FormName="activity-editor" @key="input"><DataAnnotationsValidator /><ValidationSummary class="validation-summary-errors" /><label for="activity-title">What are you planning?</label><InputText id="activity-title" class="form-control large-input" @bind-Value="input.Title" maxlength="120" placeholder="e.g. C# revision, upper body workout…" /><div class="form-grid"><div><label for="activity-category">Category</label><InputSelect id="activity-category" class="form-select" @bind-Value="input.CategoryId"><option value="0">Choose a category</option>@foreach(var c in categories){<option value="@c.Id">@c.Name</option>}</InputSelect></div><div><label for="activity-status">Status</label><InputSelect id="activity-status" class="form-select" @bind-Value="input.Status">@foreach(var s in Enum.GetValues<ActivityStatus>()){<option value="@s">@s</option>}</InputSelect></div></div><div class="form-grid"><div><label for="activity-start">Date &amp; start time</label><InputDate id="activity-start" class="form-control" Type="InputDateType.DateTimeLocal" @bind-Value="input.StartLocal" /></div><div><label for="activity-duration">Duration (minutes)</label><InputNumber id="activity-duration" class="form-control" @bind-Value="input.DurationMinutes" min="5" max="1440" /></div></div><p class="field-help">Times use @profile.TimeZoneId. <a href="preferences">Change time zone</a></p>
@if(!Id.HasValue){<div class="form-grid"><div><label for="activity-repeat">Repeat</label><InputSelect id="activity-repeat" class="form-select" @bind-Value="input.Repeat">@foreach(var r in Enum.GetValues<RepeatPattern>()){<option value="@r">@(r == RepeatPattern.None ? "Does not repeat" : r.ToString())</option>}</InputSelect></div>@if(input.Repeat!=RepeatPattern.None){<div><label for="activity-count">Number of occurrences</label><InputNumber id="activity-count" class="form-control" @bind-Value="input.Occurrences" min="1" max="12" /></div>}</div>}
<label for="activity-notes">Notes <span class="optional">optional</span></label><InputTextArea id="activity-notes" class="form-control" @bind-Value="input.Notes" rows="5" maxlength="2000" placeholder="Subjects to cover, exercises and sets, or anything you want to remember…" />
@if(conflicts.Count>0){<div class="notice warning"><strong>This time overlaps another activity.</strong><p>@string.Join(", ",conflicts.Select(x=>x.Title))</p><span>You can adjust the time or save anyway.</span></div>}
<div class="form-actions"><button class="btn btn-primary" type="submit" disabled="@busy">@(busy ? "Saving…" : "Save activity")</button><button class="btn btn-outline-primary" type="button" disabled="@busy" @onclick="CheckConflicts">Check for overlaps</button><a href="calendar" class="subtle-link">Cancel</a></div></EditForm>
@if(Id.HasValue){<div class="danger-zone">@if(confirmDelete){<p>Delete this activity permanently? Other occurrences will stay in your planner.</p><button class="btn btn-danger" disabled="@busy" @onclick="Delete">Yes, delete activity</button><button class="btn btn-light" @onclick="()=>confirmDelete=false">Keep it</button>}else{<button class="text-danger plain-button" @onclick="()=>confirmDelete=true">Delete this activity</button>}</div>}
</section><aside><div class="card tip-card"><span class="feature-icon purple-soft"><Icon Name="clock" /></span><h2>Start with something doable.</h2><p>A focused 30 minutes can make a difference. Leave space between activities so your plan has room to breathe.</p><hr /><p>Use notes for assignment details, exercise sets, or a clear next step.</p><a href="categories">Need a new category? ↗</a></div></aside></div>
}
@code {
    [Parameter] public int? Id {get;set;}
    private ApplicationUser? profile;private List<Category> categories=[];private ActivityInput input=new();private List<PlannerItem> conflicts=[];private string? error;private bool ready,busy,confirmDelete;
    protected override async Task OnParametersSetAsync(){ready=false;error=null;try{profile=await Planner.GetProfileAsync();categories=await Planner.GetCategoriesAsync();if(Id is int id){var item=await Planner.GetItemAsync(id);input=new(){Id=id,Title=item.Title,CategoryId=item.CategoryId,Notes=item.Notes,StartLocal=PlannerClock.Local(item.StartUtc,profile.TimeZoneId),DurationMinutes=item.Minutes,Status=item.Status};if(item.Category.IsArchived)throw new PlannerException("Restore this activity's category before editing it.");}else{input=new(){StartLocal=PlannerClock.Local(DateTime.UtcNow,profile.TimeZoneId).Date.AddHours(9),CategoryId=categories.FirstOrDefault()?.Id??0};}ready=true;}catch(PlannerException ex){error=ex.Message;}}
    private async Task Save(){busy=true;error=null;try{await Planner.SaveActivityAsync(input);Navigation.NavigateTo("calendar");}catch(PlannerException ex){error=ex.Message;}finally{busy=false;}}
    private async Task CheckConflicts(){error=null;message=null;try{var start=PlannerClock.ToUtc(input.StartLocal,profile!.TimeZoneId);if(input.DurationMinutes<5||input.DurationMinutes>1440)throw new PlannerException("Duration must be between 5 and 1440 minutes.");conflicts=(await Planner.GetItemsAsync(start,start.AddMinutes(input.DurationMinutes))).Where(x=>x.Id!=Id&&x.Status!=ActivityStatus.Skipped).ToList();if(conflicts.Count==0)message="No overlaps found.";}catch(PlannerException ex){error=ex.Message;}}
    private string? message;
    private async Task Delete(){busy=true;try{await Planner.DeleteActivityAsync(Id!.Value);Navigation.NavigateTo("calendar");}catch(PlannerException ex){error=ex.Message;}finally{busy=false;}}
}
@if(message is not null){<div class="notice success" role="status">@message</div>}
