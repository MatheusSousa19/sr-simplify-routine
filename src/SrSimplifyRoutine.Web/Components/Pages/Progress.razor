@page "/progress"
@attribute [Authorize]
@rendermode InteractiveServer
@inject PlannerService Planner
<PageTitle>Weekly progress · SR Simplify Routine</PageTitle>
<div class="page-heading"><div><p class="eyebrow">CELEBRATE SHOWING UP</p><h1>Your weekly balance<span class="accent">.</span></h1><p>See where your time went, and what you made happen.</p></div></div>
@if(profile is not null){<div class="period-selector"><button class="icon-button" aria-label="Previous week" @onclick="()=>Move(-7)">‹</button><strong>@week.ToString("d MMM") – @week.AddDays(6).ToString("d MMM yyyy")</strong><button class="icon-button" aria-label="Next week" @onclick="()=>Move(7)">›</button><span>@profile.TimeZoneId</span></div><div class="stats-grid"><div class="stat-card"><small>PLANNED TIME</small><strong>@((items.Sum(x=>x.Minutes)/60d).ToString("0.#")) <span>hours</span></strong><p>Across @items.Count activities</p></div><div class="stat-card"><small>COMPLETED TIME</small><strong>@((Done.Sum(x=>x.Minutes)/60d).ToString("0.#")) <span>hours</span></strong><p>@Done.Count activities completed</p></div><div class="stat-card"><small>COMPLETION RATE</small><strong>@(items.Count==0?0:(int)Math.Round(100d*Done.Count/items.Count))<span>%</span></strong><p>A reflection, not a score to chase</p></div></div><section class="card progress-card"><div class="section-heading"><div><span class="eyebrow">INTENTIONS INTO ACTION</span><h2>Progress by category</h2></div><a href="categories">Edit goals ↗</a></div>@foreach(var c in categories.Where(x=>!x.IsArchived||items.Any(i=>i.CategoryId==x.Id))){var planned=items.Where(x=>x.CategoryId==c.Id).Sum(x=>x.Minutes);var done=Done.Where(x=>x.CategoryId==c.Id).Sum(x=>x.Minutes);var maximum=Math.Max(1,Math.Max(c.WeeklyTargetMinutes,planned));<div class="category-progress"><div class="progress-labels"><span class="category-label"><i style="background:@c.Colour"></i><strong>@c.Name</strong></span><span>@done completed / @planned planned minutes</span></div><div class="comparison-track" role="img" aria-label="@c.Name: @done completed minutes out of @planned planned"><div class="planned-bar" style="width:@(100*planned/maximum)%"></div><div class="completed-bar" style="width:@(100*done/maximum)%;background:@c.Colour"></div></div><p>@(c.WeeklyTargetMinutes>0?$"Weekly target: {c.WeeklyTargetMinutes} min · {Math.Max(0,c.WeeklyTargetMinutes-done)} min to go":"Set a weekly target in Categories.")</p></div>}<div class="chart-legend"><span><i class="planned-key"></i> Planned</span><span><i class="completed-key"></i> Completed</span></div></section><div class="reflection-card"><span>✦</span><div><h2>What worked well this week?</h2><p>Keep the routines that helped. Give yourself permission to adjust the rest.</p></div><a class="btn btn-outline-primary" href="calendar">Plan your next step ↗</a></div>}
@code {
    private ApplicationUser? profile;private DateTime week;private List<Category> categories=[];private List<PlannerItem> items=[];private List<PlannerItem> Done=>items.Where(x=>x.Status==ActivityStatus.Completed).ToList();
    protected override async Task OnInitializedAsync(){profile=await Planner.GetProfileAsync();categories=await Planner.GetCategoriesAsync(true);week=PlannerClock.WeekStart(PlannerClock.Local(DateTime.UtcNow,profile.TimeZoneId));await Load();}
    private async Task Load(){var start=PlannerClock.ToUtc(week,profile!.TimeZoneId);items=(await Planner.GetItemsAsync(start,PlannerClock.ToUtc(week.AddDays(7),profile.TimeZoneId))).Where(x=>x.StartUtc>=start).ToList();}
    private async Task Move(int days){week=week.AddDays(days);await Load();}
}
