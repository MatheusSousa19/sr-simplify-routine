@page "/"
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation
<PageTitle>SR Simplify Routine</PageTitle>
<section class="welcome-hero"><span class="eyebrow">A LITTLE STRUCTURE. A LOT MORE POSSIBILITY.</span><h1>Your routine.<br />With room to <em>grow.</em></h1><p>Bring your studies, workouts and everyday priorities together. Plan your time, find your rhythm, and make progress that feels like you.</p><div class="hero-actions"><a class="btn btn-primary btn-lg" href="Account/Register" data-enhance-nav="false">Build my routine <span>↗</span></a><a class="btn btn-outline-primary btn-lg" href="Account/Login" data-enhance-nav="false">Sign in</a></div><div class="trust-line"><span>✓ Your own private workspace</span><span>✓ Categories that fit your life</span></div></section>
<div class="feature-grid"><div class="card feature-card"><span class="feature-icon purple-soft"><Icon Name="calendar" /></span><h2>A clearer week</h2><p>Give your priorities a time and place. One calendar for every part of your day.</p></div><div class="card feature-card"><span class="feature-icon green-soft"><Icon Name="layers" /></span><h2>Made for your life</h2><p>Start with studies and workouts. Create your own categories as life changes.</p></div><div class="card feature-card"><span class="feature-icon amber-soft"><Icon Name="chart" /></span><h2>Progress you can see</h2><p>Compare your intentions with your accomplishments, one week at a time.</p></div></div>
@code { protected override async Task OnInitializedAsync() { if ((await Authentication.GetAuthenticationStateAsync()).User.Identity?.IsAuthenticated == true) Navigation.NavigateTo("dashboard"); } }
