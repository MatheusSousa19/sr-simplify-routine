@page "/Account/Register"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using System.Text.Encodings.Web
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore
@inject UserManager<ApplicationUser> UserManager
@inject IEmailSender<ApplicationUser> EmailSender
@inject BotProtection BotProtection
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<Register> Logger
<PageTitle>Create account · SR Simplify Routine</PageTitle>
<div class="auth-intro"><span class="eyebrow">WELCOME TO YOUR NEXT CHAPTER</span><h1>A routine that fits your life<span class="accent">.</span></h1><p>Create your private workspace. Make time for what matters.</p></div>
<div class="auth-grid"><section class="card auth-card"><h2>Create your account</h2><StatusMessage Message="@error" /><EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register"><DataAnnotationsValidator /><ValidationSummary /><label for="Input.DisplayName">Your name</label><InputText id="Input.DisplayName" class="form-control" @bind-Value="Input.DisplayName" maxlength="60" autocomplete="given-name" placeholder="What should we call you?" /><label for="Input.Email">Email address</label><InputText id="Input.Email" class="form-control" @bind-Value="Input.Email" maxlength="254" autocomplete="username" type="email" placeholder="you@example.com" /><label for="Input.Password">Password</label><InputText id="Input.Password" class="form-control" @bind-Value="Input.Password" type="password" maxlength="128" autocomplete="new-password" /><p class="field-help">Use a unique passphrase of at least 12 characters.</p><label for="Input.ConfirmPassword">Confirm password</label><InputText id="Input.ConfirmPassword" class="form-control" @bind-Value="Input.ConfirmPassword" type="password" maxlength="128" autocomplete="new-password" /><div class="honeypot" aria-hidden="true"><label for="Input.Website">Leave this field blank</label><InputText id="Input.Website" @bind-Value="Input.Website" tabindex="-1" autocomplete="off" /></div>@if(Configuration.GetValue<bool>("BotProtection:Enabled")){<div class="cf-turnstile" data-sitekey="@Configuration["BotProtection:SiteKey"]" data-action="register"></div>}<button class="btn btn-primary w-100" type="submit">Create account ↗</button><p class="auth-switch">Already have an account? <a href="Account/Login" data-enhance-nav="false">Sign in</a></p></EditForm></section><aside class="auth-promise"><span class="promise-symbol">✦</span><h2>A clearer day starts here.</h2><p>Studies. Workouts. Time for yourself. Bring it all together in a routine you can actually live with.</p><ul><li>Your own private calendar</li><li>Categories that grow with you</li><li>Progress, one week at a time</li></ul></aside></div>
@code {
    [CascadingParameter] private HttpContext HttpContext {get;set;}=default!;
    [SupplyParameterFromForm] private InputModel Input {get;set;}=default!;
    private string? error;
    protected override void OnInitialized()=>Input??=new();
    private async Task RegisterUser()
    {
        if(!string.IsNullOrEmpty(Input.Website)){RedirectManager.RedirectTo("Account/RegisterConfirmation");return;}
        var form=await HttpContext.Request.ReadFormAsync();
        if(!await BotProtection.VerifyAsync(form["cf-turnstile-response"].ToString(),HttpContext.RequestAborted)){error="Error: Please complete the security check and try again.";return;}
        var user=new ApplicationUser{UserName=Input.Email.Trim(),Email=Input.Email.Trim(),DisplayName=Input.DisplayName.Trim()};
        IdentityResult result;
        try { result=await UserManager.CreateAsync(user,Input.Password); }
        catch(DbUpdateException){RedirectManager.RedirectTo("Account/RegisterConfirmation");return;}
        if(!result.Succeeded)
        {
            if(result.Errors.Any(x=>x.Code is "DuplicateEmail" or "DuplicateUserName")){RedirectManager.RedirectTo("Account/RegisterConfirmation");return;}
            error="Error: "+string.Join(" ",result.Errors.Select(x=>x.Description));return;
        }
        Logger.LogInformation("A new account was registered and is awaiting email verification.");
        var code=WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(await UserManager.GenerateEmailConfirmationTokenAsync(user)));
        var callback=NavigationManager.GetUriWithQueryParameters(NavigationManager.ToAbsoluteUri("Account/ConfirmEmail").AbsoluteUri,new Dictionary<string,object?>{["userId"]=user.Id,["code"]=code});
        await EmailSender.SendConfirmationLinkAsync(user,user.Email!,HtmlEncoder.Default.Encode(callback));
        RedirectManager.RedirectTo("Account/RegisterConfirmation");
    }
    private sealed class InputModel
    {
        [Required,StringLength(60)] public string DisplayName{get;set;}="";
        [Required,EmailAddress,StringLength(254)] public string Email{get;set;}="";
        [Required,StringLength(128,MinimumLength=12),DataType(DataType.Password)] public string Password{get;set;}="";
        [Compare(nameof(Password),ErrorMessage="The passwords must match.")] public string ConfirmPassword{get;set;}="";
        public string? Website{get;set;}
    }
}
